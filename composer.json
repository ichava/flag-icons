{
    "name": "ichava/flag-icons",
    "description": "265 country flag SVGs (4x3 + 1x1 aspect ratios) sourced from lipis/flag-icons. Laravel 13+, built on the Ichava ecosystem.",
    "type": "library",
    "keywords": [
        "laravel",
        "blade",
        "flags",
        "country-flags",
        "svg",
        "ichava"
    ],
    "homepage": "https://opensource.simtabi.com/products/ichava/flag-icons",
    "license": "MIT",
    "authors": [
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com",
            "homepage": "https://simtabi.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4.1 || ^8.5",
        "illuminate/support": "^13.0",
        "ichava/core": "^0.1",
        "laranail/package-tools": "^0.1.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ichava/core"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/console.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/enumerator.git"
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^3.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\Ichava\\FlagIcons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\Ichava\\FlagIcons\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\Ichava\\FlagIcons\\Providers\\IconsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/ichava/flag-icons",
        "issues": "https://github.com/ichava/flag-icons/issues",
        "security": "https://github.com/ichava/flag-icons/security/policy",
        "docs": "https://opensource.simtabi.com/documentation/ichava/flag-icons/"
    }
}
